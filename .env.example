# Copy this file to .env and fill in the required keys:
#
#     cp .env.example .env
#
# The server refuses to start without the REQUIRED keys (clear error at boot).

# -------------------------------------------------- REQUIRED
# Deepgram (streaming STT + TTS) — create a key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# OpenAI (the agent's LLM + the vocal judge) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -------------------------------------------------- OPTIONAL
# W&B Weave observability: per-turn traces, the Agents view (Agent Lens), and the
# acoustic vocal judge. Without a key the app runs fine — tracing simply disables.
# Create a key at https://wandb.ai/authorize
WANDB_API_KEY=
# Traces go to YOUR default entity under project "voice-repair-agent" unless set:
WANDB_ENTITY=
WANDB_PROJECT=

# -------------------------------------------------- DEPLOY TUNABLES (optional)
# Defaults live in server/config.py with the tradeoff behind each; the README's
# Configuration table lists them all. Uncomment to override. Examples:
#PORT=8001
#WEAVE_ENABLED=0
#VOCAL_JUDGE_ENABLED=0
#AGENT_LENS_ENABLED=0
#IDLE_PROMPT_S=15
