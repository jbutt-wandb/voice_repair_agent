# Copy this file to `.env` and fill in your own keys:
#   cp .env.example .env
#
# The app reads these two keys at startup (via python-dotenv in main.py).
# Never commit your real .env — it is gitignored.

# Deepgram — streaming speech-to-text (nova-3) and text-to-speech (aura-2).
# Get a key at https://console.deepgram.com/  (free tier includes credits).
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# OpenAI — the LLM that reasons over the manuals and calls the booking/end-call tools.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional overrides (defaults shown; see server/config.py for all tuning knobs):
# HOST=127.0.0.1
# PORT=8000
